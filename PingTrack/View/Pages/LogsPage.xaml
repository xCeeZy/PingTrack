<Page x:Class="PingTrack.View.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PingTrack.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Журнал системных действий"
      Background="{StaticResource WindowBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <Grid Margin="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📜" FontSize="28" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Системный журнал действий" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Аудит изменений, удалений и активности пользователей" Style="{StaticResource SubTitle}"/>
                </StackPanel>

                <Button Grid.Column="3" 
                        x:Name="RefreshButton" 
                        Content="🔄 Обновить" 
                        Style="{StaticResource BaseButton}" 
                        Width="120" Height="32" 
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
            <DataGrid x:Name="LogsDataGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата и время" 
                                        Binding="{Binding Log_Date, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" 
                                        Width="140"/>
                    <DataGridTextColumn Header="Инициатор" 
                                        Binding="{Binding Users.Login, TargetNullValue='Система'}" 
                                        Width="140"/>
                    <DataGridTextColumn Header="Действие" 
                                        Binding="{Binding Action_Type}" 
                                        Width="110"/>
                    <DataGridTextColumn Header="Таблица" 
                                        Binding="{Binding Table_Name}" 
                                        Width="110"/>
                    <DataGridTextColumn Header="ID Записи" 
                                        Binding="{Binding Record_ID, TargetNullValue='-'}" 
                                        Width="90"/>
                    <DataGridTextColumn Header="Подробное описание" 
                                        Binding="{Binding Description}" 
                                        Width="*"
                                        MinWidth="300">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="5,2"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
