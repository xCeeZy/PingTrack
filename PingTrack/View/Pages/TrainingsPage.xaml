<Page x:Class="PingTrack.View.Pages.TrainingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PingTrack.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Расписание тренировок"
      Background="{StaticResource WindowBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="1"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="📅"
                           FontSize="28"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Row="1"
                            Grid.Column="3"
                            VerticalAlignment="Center">
                    <TextBlock Text="Расписание тренировок"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Планирование и учёт проведённых занятий"
                               Style="{StaticResource SubTitle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.Column="1"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="Период"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <Grid Grid.Row="3"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <DatePicker x:Name="StartDatePicker"
                                Grid.Column="0"
                                Height="34"
                                FontSize="14"
                                SelectedDateChanged="DateFilter_Changed"/>

                    <TextBlock Grid.Column="2"
                               Text="—"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <DatePicker x:Name="EndDatePicker"
                                Grid.Column="4"
                                Height="34"
                                FontSize="14"
                                SelectedDateChanged="DateFilter_Changed"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Grid.Column="3"
                           Text="Группа"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <ComboBox x:Name="GroupFilter"
                          Grid.Row="3"
                          Grid.Column="3"
                          Height="34"
                          FontSize="14"
                          VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="5"
                           Text="Тренер"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <ComboBox x:Name="CoachFilter"
                          Grid.Row="3"
                          Grid.Column="5"
                          Height="34"
                          FontSize="14"
                          VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="7"
                           Text="Тип занятия"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <ComboBox x:Name="TypeFilter"
                          Grid.Row="3"
                          Grid.Column="7"
                          Height="34"
                          FontSize="14"
                          VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Grid.Column="1"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FFF8F9FA"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CountTextBlock"
                                   Grid.Column="1"
                                   Text="Всего тренировок: 0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="RefreshButton"
                                Grid.Column="2"
                                Content="🔄 Обновить"
                                Style="{StaticResource BaseButton}"
                                Width="110"
                                Height="32"
                                FontSize="13"
                                Click="RefreshButton_Click"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="TrainingsDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          MouseDoubleClick="TrainingsDataGrid_MouseDoubleClick"
                          SelectionChanged="TrainingsDataGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding Date}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Время"
                                            Binding="{Binding Time}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Группа"
                                            Binding="{Binding Group}"
                                            Width="*"
                                            MinWidth="150"/>

                        <DataGridTextColumn Header="Тренер"
                                            Binding="{Binding Coach}"
                                            Width="200"/>

                        <DataGridTextColumn Header="Тип занятия"
                                            Binding="{Binding Type}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Примечание"
                                            Binding="{Binding Note}"
                                            Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="6"
                Grid.Column="1"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AttendanceButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Content="✅ Посещаемость"
                        Style="{StaticResource BaseButton}"
                        Width="160"
                        Height="36"
                        IsEnabled="False"
                        Click="AttendanceButton_Click"/>

                <Button x:Name="ExportButton"
                        Grid.Row="1"
                        Grid.Column="4"
                        Content="📄 Экспорт"
                        Style="{StaticResource BaseButton}"
                        Width="120"
                        Height="36"
                        Click="ExportButton_Click"/>

                <Button x:Name="AddTrainingButton"
                        Grid.Row="1"
                        Grid.Column="6"
                        Content="➕ Добавить"
                        Style="{StaticResource PrimaryButton}"
                        Width="140"
                        Height="36"
                        Click="AddTrainingButton_Click"/>

                <Button x:Name="EditTrainingButton"
                        Grid.Row="1"
                        Grid.Column="8"
                        Content="✏️ Изменить"
                        Style="{StaticResource BaseButton}"
                        Width="130"
                        Height="36"
                        IsEnabled="False"
                        Click="EditTrainingButton_Click"/>

                <Button x:Name="DeleteTrainingButton"
                        Grid.Row="1"
                        Grid.Column="10"
                        Content="🗑️ Удалить"
                        Style="{StaticResource BaseButton}"
                        Width="120"
                        Height="36"
                        IsEnabled="False"
                        Click="DeleteTrainingButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>