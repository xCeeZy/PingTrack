<Page x:Class="PingTrack.View.Pages.JournalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PingTrack.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Журнал посещаемости"
      Background="{StaticResource WindowBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="1"
                Style="{StaticResource Card}"
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="📋"
                           FontSize="28"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="Журнал посещаемости"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Учёт присутствия игроков на тренировках"
                               Style="{StaticResource SubTitle}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.Column="1"
                Style="{StaticResource Card}"
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Поиск"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Height="34"
                        BorderBrush="{StaticResource StrokeStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="🔍"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Height="34"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 Text="Поиск по игроку"
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Группа"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <ComboBox x:Name="GroupFilter"
                          Grid.Row="2"
                          Grid.Column="2"
                          Height="34"
                          FontSize="14"
                          VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="4"
                           Text="Присутствие"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <ComboBox x:Name="PresenceFilter"
                          Grid.Row="2"
                          Grid.Column="4"
                          Height="34"
                          FontSize="14"
                          VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="6"
                           Text="Дата с"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <DatePicker x:Name="StartDateFilter"
                            Grid.Row="2"
                            Grid.Column="6"
                            Height="34"
                            FontSize="14"
                            VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="8"
                           Text="Дата по"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <DatePicker x:Name="EndDateFilter"
                            Grid.Row="2"
                            Grid.Column="8"
                            Height="34"
                            FontSize="14"
                            VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Grid.Column="1"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FFF8F9FA"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CountTextBlock"
                                   Grid.Column="0"
                                   Text="Всего записей: 0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="RefreshButton"
                                Grid.Column="1"
                                Content="🔄 Обновить"
                                Style="{StaticResource BaseButton}"
                                Width="110"
                                Height="32"
                                FontSize="13"
                                Click="RefreshButton_Click"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="JournalDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          MouseDoubleClick="JournalDataGrid_MouseDoubleClick"
                          SelectionChanged="JournalDataGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding Date}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Игрок"
                                            Binding="{Binding Player}"
                                            Width="*"
                                            MinWidth="180"/>

                        <DataGridTextColumn Header="Группа"
                                            Binding="{Binding Group}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Тип тренировки"
                                            Binding="{Binding Training}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Присутствие"
                                            Binding="{Binding PresenceText}"
                                            Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Padding" Value="6,2"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                            <Setter Property="Foreground" Value="#27AE60"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="6"
                Grid.Column="1"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PrevPageButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Content="◀ Назад"
                        Style="{StaticResource BaseButton}"
                        Width="100"
                        Height="36"
                        Click="PrevPageButton_Click"/>

                <TextBlock x:Name="PageInfoText"
                           Grid.Row="1"
                           Grid.Column="3"
                           Text="Страница 1 из 1"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"
                           MinWidth="140"
                           TextAlignment="Center"/>

                <Button x:Name="NextPageButton"
                        Grid.Row="1"
                        Grid.Column="5"
                        Content="Вперёд ▶"
                        Style="{StaticResource BaseButton}"
                        Width="100"
                        Height="36"
                        Click="NextPageButton_Click"/>

                <Button x:Name="AddButton"
                        Grid.Row="1"
                        Grid.Column="7"
                        Content="➕ Добавить"
                        Style="{StaticResource PrimaryButton}"
                        Width="140"
                        Height="36"
                        Click="AddButton_Click"/>

                <Button x:Name="DeleteButton"
                        Grid.Row="1"
                        Grid.Column="9"
                        Content="🗑️ Удалить"
                        Style="{StaticResource BaseButton}"
                        Width="120"
                        Height="36"
                        IsEnabled="False"
                        Click="DeleteButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>