<Window x:Class="PingTrack.View.Windows.AddEditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PingTrack.View.Windows"
        mc:Ignorable="d"
        Title="Пользователь"
        WindowStartupLocation="CenterScreen"
        Width="420" 
        SizeToContent="Height" 
        Background="{StaticResource WindowBrush}"
        ResizeMode="NoResize">

    <StackPanel Margin="20">

        <TextBlock Text="Данные пользователя"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="Логин" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginBox"
                     Height="34"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="Пароль" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="34"
                         FontSize="14"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="ФИО" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="FullNameBox"
                     Height="34"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,15">
            <StackPanel Width="220">
                <TextBlock Text="Роль" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                <ComboBox x:Name="RoleComboBox"
                          Height="36"
                          FontSize="14"
                          DisplayMemberPath="Role_Name"
                          SelectedValuePath="ID_Role"/>
            </StackPanel>

            <CheckBox x:Name="IsActiveCheckBox"
                      Content="Активен"
                      FontSize="14"
                      VerticalAlignment="Bottom"
                      Margin="24,0,0,8"/>
        </StackPanel>

        <StackPanel x:Name="PhonePanel" Visibility="Collapsed" Margin="0,0,0,20">
            <TextBlock Text="Номер телефона (только для игроков)" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="PhoneBox"
                     Height="34"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Style="{StaticResource PrimaryButton}"
                    Width="160"
                    Height="40"
                    HorizontalAlignment="Center"
                    Click="SaveButton_Click"/>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Отмена"
                    Style="{StaticResource BaseButton}"
                    Width="140"
                    Height="40"
                    HorizontalAlignment="Center"
                    Click="CancelButton_Click"/>
        </Grid>

    </StackPanel>
</Window>