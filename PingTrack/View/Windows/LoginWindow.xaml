<Window x:Class="PingTrack.View.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PingTrack.View.Windows"
        mc:Ignorable="d"
        Title="PingTrack — Авторизация"
        WindowStartupLocation="CenterScreen"
        Width="440"
        Height="620"
        Background="{StaticResource PanelBrush}"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Row="1"
                 Grid.Column="1"
                 Height="120"
                 HorizontalAlignment="Center">
            <Image Source="/Resources/Images/logo.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Viewbox>

        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   Text="Вход в систему"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"
                   HorizontalAlignment="Center"/>

        <Border Grid.Row="5"
                Grid.Column="1"
                Background="#F9FAFB"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="Логин"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <Border Grid.Row="3"
                        Grid.Column="1"
                        BorderBrush="{StaticResource StrokeStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{StaticResource PanelBrush}"
                        Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="LoginTextBox"
                                 Grid.Column="1"
                                 FontSize="15"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Foreground="{StaticResource TextBrush}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="5"
                           Grid.Column="1"
                           Text="Пароль"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <Border Grid.Row="7"
                        Grid.Column="1"
                        BorderBrush="{StaticResource StrokeStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{StaticResource PanelBrush}"
                        Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="PasswordBox"
                                     Grid.Column="1"
                                     FontSize="15"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Foreground="{StaticResource TextBrush}"/>

                        <TextBox x:Name="VisiblePasswordBox"
                                 Grid.Column="1"
                                 FontSize="15"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Foreground="{StaticResource TextBrush}"
                                 Visibility="Collapsed"/>

                        <Button x:Name="TogglePasswordButton"
                                Grid.Column="2"
                                Width="44"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="TogglePasswordButton_Click">
                            <Image x:Name="EyeIcon"
                                   Source="/Resources/Images/eye_closed.png"
                                   Width="20"
                                   Height="20"
                                   Opacity="0.6"/>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock x:Name="CapsLockWarning"
                           Grid.Row="8"
                           Grid.Column="1"
                           Text="Включен Caps Lock"
                           Foreground="#EF4444"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,2,0,0"
                           Visibility="Collapsed"/>

                <Button x:Name="LoginButton"
        Grid.Row="9"
        Grid.Column="1"
        Content="Войти в систему"
        Style="{StaticResource PrimaryButton}"
        Height="46"
        FontSize="15"
        FontWeight="Bold"
        IsDefault="True"
        Click="LoginButton_Click"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="7"
                   Grid.Column="1"
                   Text="© 2026 PingTrack. Все права защищены."
                   FontSize="11"
                   Foreground="{StaticResource TextMutedBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>
</Window>