<Window x:Class="PingTrack.View.Windows.PlayerCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка игрока"
        Height="560"
        Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--#region Заголовок-->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="62"
                        Height="62"
                        CornerRadius="31"
                        Background="#FFE8F0FE">
                    <TextBlock x:Name="InitialText"
                               Text="И"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#FF2563EB"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerNameText"
                               Text="ФИО игрока"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="GroupNameText"
                               Text="Группа"
                               FontSize="14"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region Основная информация-->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Возраст" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="AgeText" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Телефон" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="PhoneText" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Мед. справка" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="MedicalText" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region Статистика-->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Статистика посещаемости"
                           Style="{StaticResource SectionTitle}"/>

                <UniformGrid Grid.Row="2" Columns="4">
                    <StackPanel>
                        <TextBlock Text="Всего" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="TotalTrainingsText" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Посещено" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="PresentText" FontSize="22" FontWeight="Bold" Foreground="#27AE60"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Пропущено" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="AbsentText" FontSize="22" FontWeight="Bold" Foreground="#E74C3C"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Посещаемость" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="PercentText" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </UniformGrid>

                <DataGrid Grid.Row="4"
                          x:Name="LastAttendanceGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"/>
                        <DataGridTextColumn Header="Тренировка" Binding="{Binding TrainingType}" Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region Кнопки-->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Закрыть"
                    Style="{StaticResource BaseButton}"
                    Width="120"
                    Height="36"
                    Click="CloseButton_Click"/>
        </StackPanel>
        <!--#endregion-->
    </Grid>
</Window>